PORT=5000
NODE_ENV=development

# MongoDB - use a local instance for dev or a MongoDB Atlas connection string for production
MONGO_URI=mongodb+srv://admin:admin123@cluster7.3svbqyk.mongodb.net/fleetflow?retryWrites=true&w=majority&appName=Cluster7

# JWT
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# CORS
CLIENT_URL=http://localhost:5173

# Vessel position simulation
SIMULATION_ENABLED=true
SIMULATION_INTERVAL=5000

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# AI Fleet Assistant (optional) — leave unset to use the rule-based fallback.
# If set, /api/assistant/ask calls the Anthropic API grounded in live fleet data.
ANTHROPIC_API_KEY=
